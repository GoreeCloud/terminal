executable(
  'goreecloud-terminal',
  [
    'main.c',
    'gc-context.c',
    'gc-command-boundaries.c',
    'gc-workspace-layout.c',
    'gc-profile.c',
    'gc-session-store.c',
    'gc-link-utils.c',
    'gc-paste-safety.c',
    'gc-shell-state.c',
    'gc-onboarding-state.c',
    'gc-onboarding.c',
    'gc-terminal-session.c',
    'gc-workspace.c',
    'gc-terminal-window.c',
  ],
  dependencies: [gtk_dep, vte_dep, glib_dep, gio_dep, pcre2_dep],
  install: true,
)
