// Slint-native preview with GoreeCloud UI alpha dark semantic palette.
// The OS provides window decoration; custom WCN chrome is not claimed yet.
import { Button } from "std-widgets.slint";

export component TerminalWindow inherits Window {
    title: "GoreeCloud Terminal";
    preferred-width: 1030px;
    preferred-height: 650px;
    background: #0D121D;

    in-out property <[string]> rows: [];
    in-out property <[string]> tabs: [];
    in-out property <int> active-tab: 0;
    in-out property <string> status: "Starting local shell…";
    callback typed(string, bool, bool, bool);
    callback new-tab();
    callback close-tab();
    callback select-tab(int);
    callback scroll(int);
    callback copy-visible();
    callback paste();
    forward-focus: keys;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Rectangle {
            height: 52px;
            background: #171D2A;
            border-radius: 18px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: center;
                Text {
                    text: "GOREECLOUD / TERMINAL";
                    color: #F2F4FB;
                    font-size: 16px;
                    font-weight: 650;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "LOCAL • OFFLINE";
                    color: #95E0BB;
                    font-size: 12px;
                }
            }
        }

        Rectangle {
            height: 44px;
            background: #252D3D;
            border-radius: 12px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                for tab[index] in root.tabs: Button {
                    text: root.active-tab == index ? "● " + tab : tab;
                    clicked => { root.select-tab(index); keys.focus(); }
                }
                Button { text: "New"; clicked => { root.new-tab(); keys.focus(); } }
                Button { text: "Close"; clicked => { root.close-tab(); keys.focus(); } }
                Button { text: "↑"; clicked => { root.scroll(-10); keys.focus(); } }
                Button { text: "↓"; clicked => { root.scroll(10); keys.focus(); } }
                Button { text: "Copy"; clicked => { root.copy-visible(); keys.focus(); } }
                Button { text: "Paste"; clicked => { root.paste(); keys.focus(); } }
            }
        }

        keys := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                root.typed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                accept
            }
            Rectangle {
                background: #171D2A;
                border-radius: 18px;
                border-width: 1px;
                border-color: #505B70;
                VerticalLayout {
                    padding: 18px;
                    spacing: 0px;
                    for line in root.rows: Text {
                        text: line;
                        font-family: "monospace";
                        font-size: 15px;
                        height: 22px;
                        color: #F2F4FB;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }
            }
        }

        Rectangle {
            height: 34px;
            background: #252D3D;
            border-radius: 12px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: root.status;
                    color: #CED5E5;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
